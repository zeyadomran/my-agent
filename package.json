{
  "name": "my-agent",
  "productName": "my-agent",
  "version": "0.0.0",
  "private": true,
  "description": "A local desktop assistant with one durable conversation.",
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:static": "npm run typecheck && npm run lint && npm run format:check",
    "check": "npm run check:static && npm test",
    "test": "npm run test:app && npm run test:git-hooks",
    "test:app": "vitest run",
    "test:git-hooks": "node --test scripts/git-hooks/verify.mjs",
    "hooks:install": "node scripts/git-hooks/install.mjs",
    "prepare": "node scripts/git-hooks/install.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
